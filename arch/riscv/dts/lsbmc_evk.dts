/dts-v1/;

/ {
    compatible = "linkedsemi,bmc";
    #address-cells = <2>;
	#size-cells = <2>;
	chosen {
		stdout-path = &uart0;
	};

    memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x800000>;
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <50000000>;

		c908_0: cpu@0 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdc";
			reg = <0>;
			i-cache-block-size = <64>;
			i-cache-size = <65536>;
			i-cache-sets = <512>;
			d-cache-block-size = <64>;
			d-cache-size = <65536>;
			d-cache-sets = <512>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                #address-cells = <1>;
			};
		};

		c908_1: cpu@1 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdc";
			reg = <1>;
			i-cache-block-size = <64>;
			i-cache-size = <65536>;
			i-cache-sets = <512>;
			d-cache-block-size = <64>;
			d-cache-size = <65536>;
			d-cache-sets = <512>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                #address-cells = <1>;
			};
		};

		c908_2: cpu@2 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdc";
			reg = <2>;
			i-cache-block-size = <64>;
			i-cache-size = <65536>;
			i-cache-sets = <512>;
			d-cache-block-size = <64>;
			d-cache-size = <65536>;
			d-cache-sets = <512>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                #address-cells = <1>;
			};
		};

		c908_3: cpu@3 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdc";
			reg = <3>;
			i-cache-block-size = <64>;
			i-cache-size = <65536>;
			i-cache-sets = <512>;
			d-cache-block-size = <64>;
			d-cache-size = <65536>;
			d-cache-sets = <512>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                #address-cells = <1>;
			};
		};
		l2_cache: l2-cache {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-size = <1048576>;
			cache-sets = <1024>;
			cache-unified;
		};
    };

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&plic>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		plic: interrupt-controller@b0000000 {
			compatible = "riscv,plic0";
			reg = <0x00 0xb0000000 0x0 0x01000000>;
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>,
					      <&cpu1_intc 11>, <&cpu1_intc 9>,
					      <&cpu2_intc 11>, <&cpu2_intc 9>,
					      <&cpu3_intc 11>, <&cpu3_intc 9>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			riscv,ndev = <240>;
            riscv,max-priority = <7>;
		};

		clint: timer@b4000000 {
			compatible = "riscv,clint0";
			reg = <0x00 0xb4000000 0x0 0x00010000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>,
					      <&cpu1_intc 3>, <&cpu1_intc 7>,
					      <&cpu2_intc 3>, <&cpu2_intc 7>,
					      <&cpu3_intc 3>, <&cpu3_intc 7>;
		};

		uart0: serial@10015000 {
			compatible = "ns16550";
			reg = <0x00 0x10015000 0x0 0x1000>;
			interrupts = <16>;
            clock-frequency = <50000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};
    };
};