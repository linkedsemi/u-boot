		// 		queue3 {};
		// 	};

		// 	mtl_tx_setup_1: tx-queues-config {
		// 		snps,tx-queues-to-use = <4>;
		// 		queue0 {};
		// 		queue1 {};
		// 		queue2 {};
		// 		queue3 {};
		// 	};
		// 	fixed-link {
		// 		speed = <1000>;
		// 		full-duplex;
		// 	};
		// };

		sdhci: mmc@92000000 {
			compatible = "snps,dwcmshc-sdhci";
			reg = <0x0 0x92000000 0x0 0x4000>;
			interrupts = <60 4>;
			clocks = <&fixed_clk_core>;
			clock-names = "core";
			/* eMMC, 8-bit data lines */
			bus-width = <8>;
			non-removable;
			no-sd;
			no-sdio;
			// cap-mmc-highspeed;
			status = "okay";
		};
		fwspi: spi@61000000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dwc-ssi-1.01a";
			reg = <0x0 0x61000000 0x0 0x1000>;
			clocks = <&fixed_clk_core>;
			interrupts = <44 4>;
			num-cs = <2>;
			reg-io-width = <4>;
			status = "okay";

			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <50000>;
			};
		};

		ahb_dma: dma-controller@1200000 {
			compatible = "snps,dma-spear1340";
			reg = <0x0 0x01200000 0x0 0x4000>;
			interrupts = <47 4>;
			status = "okay";

			dma-masters = <1>;
			dma-channels = <8>;
			// #dma-cells = <3>;
			chan_allocation_order = <0>;
			chan_priority = <0>;
			block_size = <0x7ff>;
			data-width = <4>;
			multi-block = <1 1 1 1 1 1 1 1>;
			snps,max-burst-len = <8 8 8 8 8 8 8 8>;
		};
		axi_dma: dma-controller@65100000 {
			compatible = "snps,axi-dma-1.01a";
			reg = <0x0 0x65100000 0x0 0x4000>;
			interrupts = <50 4>;
			clocks = <&fixed_clk_core>, <&fixed_clk_core>;
			clock-names = "core-clk", "cfgr-clk";
			#dma-cells = <1>;
			dma-channels = <8>;
			snps,block-size = <2048 2048 2048 2048 2048 2048 2048 2048>;
			snps,priority = <0 1 2 3 4 5 6 7>;
			snps,dma-masters = <1>;
			snps,data-width = <3>;
			snps,axi-max-burst-len = <16>;
			status = "okay";
		};
		mbox0: mailbox@b0800000 {
			compatible = "linkedsemi,ls-mbox";
			reg = <0x0 0xb0800000 0x0 0x800>;
			interrupts = <104 4>;
			#mbox-cells = <5>;
			tx-syscon = <&cpu1_syscon>;
			rx-syscon = <&cpu0_syscon>;
			tx-intr-set-offset = <0x2c4>;
			rx-intr-clr-offset = <0x1f8>;
			status = "okay";

		};
		vuart0: vuart@b0800810 {
			compatible = "linkedsemi,ls-vuart";
			reg = <0x0 0xb0800810 0x0 0x40>;
			mboxes = <&mbox0 1 8 3 8 3>;
			status = "okay";
		};
		kcs0: kcs@b0800800 {
			compatible = "linkedsemi,ls-kcs-bmc";
			reg = <0x0 0xb0800800 0x0 0x10>;
			kcs_chan = <1>;
			mboxes = <&mbox0 0 4 3 4 3>;
			status = "okay";
		};
		// xhci0: usb@94000000 {
		// 	compatible = "generic-xhci";
		// 	reg = <0x0 0x94000000 0x0 0x10000>;
		// 	interrupts = <65 4>;
		// 	// phys = <&usb_phy PHY_TYPE_USB3>;
		// 	status = "okay";

		// };

		cpu0_syscon: syscon@1300000 {
			compatible = "syscon";
			reg = <0x0 0x01300000 0x0 0x1000>;
		};
		cpu1_syscon: syscon@60500000 {
			compatible = "syscon";
			reg = <0x0 0x60500000 0x0 0x1000>;
		};
		pipe_syscon: syscon@90928000 {
			compatible = "syscon";
			reg = <0x0 0x90928000 0x0 0x1000>;
		};

		pcie0_ep: pcie-ep@90000000 {
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			compatible = "linkedsemi,ls-pcie-ep","simple-mfd";
			reg = <0x0 0x90000000 0x0 0x100000>,
				<0x0 0x90100000 0x0 0x100000>,
				<0x0 0x90300000 0x0 0x4000>,
				<0x0 0x90380000 0x0 0x2000>,
				<0x0 0x70000000 0x0 0x10000000>,
				<0x0 0x96012000 0x0 0x1000>,
				<0x0 0x94000000 0x0 0x100000>,
				<0x0 0x90900000 0x0 0x10000>,
				<0x0 0x6a8 0x0 0x480>,
				<0x0 0xba0 0x0 0x6c>,
				<0x0 0xc90 0x0 0x3c>,
				<0x0 0xb0000018 0x0 0x8>,
				<0x0 0xb0000038 0x0 0x8>,
				<0x40000000 0x0 0x100 0x0>;
			reg-names = "dbi","dbi2","atu","dma","addr_space","xhci_vhub",
				"xhci_hc","vpn","pipe_cfg0","pipe_cfg1","pipe_cfg2",
				"xhci_msi","vga_msi","xhci_hc_range";
			memory-region = <&vga0>, <&vbios0>;
			memory-region-names = "vga0", "vbios0";
			interrupts =<198 4>,
						<197 4>,
						<196 4>,
						<195 4>,
						<194 4>,
						<192 4>,
						<191 4>;
			interrupt-names = "dma","smlh_link","ip","radm_to","aux","msg","misc";
			pipesys-cfg = <&pipe_syscon>;



			// clocks = <&zynqmp_clk PL0_REF>;
			// clock-names = "pl0-clk";
			// clocks = <&cru ACLK_PCIE>, <&cru ACLK_PERF_PCIE>,
			// 	 <&cru PCLK_PCIE>, <&cru SCLK_PCIE_PM>;
			// clock-names = "aclk", "aclk-perf",
			// 	      "hclk", "pm";
			max-functions = /bits/ 8 <8>;
			num-lanes = <1>;
			max-link-speed = <1>;
			// resets = <&cru SRST_PCIE_CORE>, <&cru SRST_PCIE_MGMT>,
			// 	 <&cru SRST_PCIE_MGMT_STICKY>, <&cru SRST_PCIE_PIPE>,
			// 	 <&cru SRST_PCIE_PM>, <&cru SRST_P_PCIE>,
			// 	 <&cru SRST_A_PCIE>;
			// reset-names = "core", "mgmt", "mgmt-sticky", "pipe",
			// 	      "pm", "pclk", "aclk";
			// phys = <&pcie_phy 0>, <&pcie_phy 1>,
			//        <&pcie_phy 2>, <&pcie_phy 3>;
			// phy-names = "pcie-phy-0", "pcie-phy-1",
			// 	    "pcie-phy-2", "pcie-phy-3";
			// rockchip,max-outbound-regions = <32>;
			// pinctrl-names = "default";
			// pinctrl-0 = <&pcie_clkreqnb_cpm>;
			status = "okay";
			mctp_pcie0: mctp-pcie@0 {
				compatible = "linkedsemi,ls-pcie-mctp";
				reg = <0x0 0xbac 0x0 0x50>,
					<0x0 0xb44 0x0 0x8>,
					<0x0 0xbfc 0x0 0x10>;
				reg-names = "rx", "tx","bdf";
				interrupts = <193 4>;
				status = "okay";
			};
		};
    };
};
