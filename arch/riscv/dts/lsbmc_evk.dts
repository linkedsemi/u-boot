/dts-v1/;

/ {
	compatible = "linkedsemi,bmc";
	#address-cells = <2>;
	#size-cells = <2>;
	fixed_clk_core: fixed-clock-core {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <4000000>;
	};
	chosen {
		//bootargs = "earlycon console=ttyS0,1152000 norandmaps no4lvl debug";
		//bootargs = "earlycon console=ttyS0,1152000 norandmaps no4lvl loglevel=8 ignore_loglevel dyndbg=\"file drivers/usb/host/xhci* +p; file drivers/usb/core/hub.c +p; file drivers/net/ethernet/stmicro/stmmac* +p;\"";
		//bootargs = "earlycon console=ttyS0,1152000 norandmaps no4lvl loglevel=8 ignore_loglevel dyndbg=\"file drivers/mmc/host/sdhci* +p; file drivers/mmc/core/core.c +p; file drivers/dma/* +p; file kernel/dma/* +p; file drivers/spi/spi-dw* +p;\"";
		//bootargs = "earlycon console=ttyS0,1152000 norandmaps no4lvl loglevel=8 ignore_loglevel sdhci.debug_quirks=0x02000060 dyndbg=\"file drivers/net/ethernet/stmicro/stmmac* +p;\"";
		bootargs = "earlycon console=ttyS0,1152000 norandmaps no4lvl loglevel=8 ignore_loglevel ";
		stdout-path = &uart12;
		linux,initrd-start = <0x1 0x80000000>;
		// linux,initrd-end = <0x1 0x83700e00>; //xuantie-rootfs
		linux,initrd-end = <0x1 0x805e8000>;
	};

	aliases {
		vuart0 = &vuart0;
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0x0 0xc0000000 0x1 0x00000000>;
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		vga0: vga@d0000000 {
			reg = <0x0 0xd0000000 0x0 0x1000000>;
			no-map;
		};
		vbios0: vbios@d1000000 {
			reg = <0x0 0xd1000000 0x0 0x10000>;
			no-map;
		};
	};
	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <37037000>;

		c908_0: cpu@0 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdcv_zicbom_zicbop_zicboz_zihintpause_zfh_zba_zbb_zbc_zbs_sscofpmf_svinval_svnapot_svpbmt_xtheadc_xtheadvdot";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i","m","a","f","d","c","v","zicbom","zicbop","zicboz","zihintpause",
				"zfh","zba","zbb","zbc","zbs","sscofpmf","svinval","svnapot","svpbmt","xtheadc","xtheadvdot";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			reg = <0>;
			i-cache-block-size = <64>;
			i-cache-size = <32768>;
			i-cache-sets = <128>;
			d-cache-block-size = <64>;
			d-cache-size = <32768>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                		#address-cells = <0>;
			};
		};

		c908_1: cpu@1 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdcv_zicbom_zicbop_zicboz_zihintpause_zfh_zba_zbb_zbc_zbs_sscofpmf_svinval_svnapot_svpbmt_xtheadc_xtheadvdot";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i","m","a","f","d","c","v","zicbom","zicbop","zicboz","zihintpause",
				"zfh","zba","zbb","zbc","zbs","sscofpmf","svinval","svnapot","svpbmt","xtheadc","xtheadvdot";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			reg = <1>;
			i-cache-block-size = <64>;
			i-cache-size = <32768>;
			i-cache-sets = <128>;
			d-cache-block-size = <64>;
			d-cache-size = <32768>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                		#address-cells = <0>;
			};
		};

		c908_2: cpu@2 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdcv_zicbom_zicbop_zicboz_zihintpause_zfh_zba_zbb_zbc_zbs_sscofpmf_svinval_svnapot_svpbmt_xtheadc_xtheadvdot";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i","m","a","f","d","c","v","zicbom","zicbop","zicboz","zihintpause",
				"zfh","zba","zbb","zbc","zbs","sscofpmf","svinval","svnapot","svpbmt","xtheadc","xtheadvdot";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			reg = <2>;
			i-cache-block-size = <64>;
			i-cache-size = <32768>;
			i-cache-sets = <128>;
			d-cache-block-size = <64>;
			d-cache-size = <32768>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                		#address-cells = <0>;
			};
		};

		c908_3: cpu@3 {
			compatible = "thead,c908", "riscv";
			device_type = "cpu";
			riscv,isa = "rv64imafdcv_zicbom_zicbop_zicboz_zihintpause_zfh_zba_zbb_zbc_zbs_sscofpmf_svinval_svnapot_svpbmt_xtheadc_xtheadvdot";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i","m","a","f","d","c","v","zicbom","zicbop","zicboz","zihintpause",
				"zfh","zba","zbb","zbc","zbs","sscofpmf","svinval","svnapot","svpbmt","xtheadc","xtheadvdot";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			reg = <3>;
			i-cache-block-size = <64>;
			i-cache-size = <32768>;
			i-cache-sets = <128>;
			d-cache-block-size = <64>;
			d-cache-size = <32768>;
			d-cache-sets = <128>;
			next-level-cache = <&l2_cache>;
			mmu-type = "riscv,sv39";

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
                		#address-cells = <0>;
			};
		};
		l2_cache: l2-cache {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-size = <524288>;
			cache-sets = <512>;
			cache-unified;
		};
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&plic>;
		#address-cells = <2>;
		#size-cells = <2>;
		dma-noncoherent;
		ranges;

		plic: interrupt-controller@4000000000 {
			compatible =  "thead,c900-plic";
			reg = <0x40 0x00000000 0x0 0x04000000>;
			interrupts-extended = <&cpu0_intc 0xffffffff>, <&cpu0_intc 9>,
					      <&cpu1_intc 0xffffffff>, <&cpu1_intc 9>,
					      <&cpu2_intc 0xffffffff>, <&cpu2_intc 9>,
					      <&cpu3_intc 0xffffffff>, <&cpu3_intc 9>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <2>;
			riscv,ndev = <240>;
            		riscv,max-priority = <7>;
		};

		clint: clint@4004000000 {
			compatible = "thead,c900-clint";
			reg = <0x40 0x04000000 0x0 0x00010000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>,
					      <&cpu1_intc 3>, <&cpu1_intc 7>,
					      <&cpu2_intc 3>, <&cpu2_intc 7>,
					      <&cpu3_intc 3>, <&cpu3_intc 7>;
		};

		uart12: serial@9600e000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x00 0x9600e000 0x0 0x1000>;
			interrupts = <71 4>;
			clock-frequency = <37037000>;
			current-speed = <1152000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "okay";
		};
		// rgmii0: ethernet@95000000 {
		// 	compatible = "snps,dwmac","snps,dwmac-5.20";
		// 	reg = <0x0 0x95000000 0x0 0x4000>;
		// 	interrupts = <101 4>;
		// 	interrupt-names = "macirq";
		// 	phy-mode = "rgmii";
		// 	rx-fifo-depth = <2048>;
		// 	tx-fifo-depth = <2048>;
		// 	snps,ps-speed = <1000>;
		// 	snps,tso;
		// 	snps,txpbl = <16>;
		// 	snps,rxpbl = <16>;
		// 	status = "okay";

		// 	// snps,mtl-rx-config = <&mtl_rx_setup_1>;
		// 	// snps,mtl-tx-config = <&mtl_tx_setup_1>;
		// 	// snps,axi-config = <&stmmac_axi_config_0>;
		// 	// stmmac_axi_config_0: stmmac-axi-config {
		// 	// 	snps,wr_osr_lmt = <0x7>;
		// 	// 	snps,rd_osr_lmt = <0x7>;
		// 	// 	snps,blen = <0 0 0 0 16 8 4>;
		// 	// };
		// 	// mtl_rx_setup_1: rx-queues-config {
		// 	// 	snps,rx-queues-to-use = <4>;
		// 	// 	queue0 {};
		// 	// 	queue1 {};
		// 	// 	queue2 {};
		// 	// 	queue3 {};
		// 	// };

		// 	// mtl_tx_setup_1: tx-queues-config {
		// 	// 	snps,tx-queues-to-use = <4>;
		// 	// 	queue0 {};
		// 	// 	queue1 {};
		// 	// 	queue2 {};
